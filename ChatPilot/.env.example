PORT=3000
NODE_ENV=local
FRONTEND_URL=https://chatpilot.trygetchurnshield.com
DATABASE_URL=postgresql://[USERNAME]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]
WB_BASE_URL=xxxxxxxxxxxxxxx
GEMINI_API_KEY=xxxxxxxx
SENTRY_URL=xxxxxxxxxxxxxxx
REDIS_URL=redis://localhost
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=password

chatPilot_API_KEY=keep-it-secret-here

SUPABASE_STORAGE_URL=xxxxxxxx
SUPABASE_SERVICE_KEY=xxxxxxxx

APIFY_TOKEN=
APIFY_PROXY_PASSWORD=
ENABLED_SOURCES=npc,nairaland,facebook,twitter,instagram,tiktok
SEARCH_QUERIES=looking for land to buy in Lekki,need land for sale in Lagos,buy property Nigeria budget
SEARCH_LOCATION=Nigeria
MAX_RESULTS=25
USE_MOCK_SCRAPE=false
SCRAPING_ENABLED=false
MONTHLY_LEAD_QUOTA=300
DAILY_LEAD_LIMIT=50
POOL_TOPUP_MAX_CYCLES=2
ADMIN_SECRET=

# Auth / vault
JWT_SECRET=
JWT_REFRESH_SECRET=
INVITE_TOKEN_TTL_HOURS=72

# Locale (this deployment is Nigeria)
DEFAULT_TIMEZONE=Africa/Lagos
DEFAULT_LOCALE=en

# AI qualification core
AI_MAX_IMAGE_PARTS=4

# Automated nudge ladder (hours after the last inbound message)
FOLLOW_UP_STAGE_HOURS=24,72

# Meta social inbound (Facebook + Instagram comments and DMs)
# Leave blank until the Meta app exists — the webhook stays inert and the app boots normally.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
META_OAUTH_REDIRECT_URI=https://api.chat-pilot.dev/api/v1/social/oauth/facebook/callback
META_REPLY_ENABLED=true
META_PRIVATE_REPLY_ENABLED=false
META_MAX_REPLIES_PER_HOUR=30
META_INTENT_MODEL=gemini-2.5-flash
META_INTENT_THRESHOLD=0.6
META_DEDUPE_WINDOW_MIN=60
SOCIAL_WA_PREFILL_TEMPLATE=Hi {company}, I saw your property post on {platform} and I'm interested. [{ref}]
