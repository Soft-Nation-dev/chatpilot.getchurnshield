# ── Core (required — the app will not boot without these) ──
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://[USER]:[PASSWORD]@postgres:5432/[DATABASE]
REDIS_URL=redis://redis:6379
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=default
chatPilot_API_KEY=

# ── Postgres container ──
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── Auth & encryption ──
# JWT_SECRET also encrypts stored messages. Changing it makes existing
# message history permanently unreadable. Back it up.
JWT_SECRET=
JWT_REFRESH_SECRET=
INVITE_TOKEN_TTL_HOURS=72

# ── Admin surfaces ──
ADMIN_SECRET=
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=

# ── URLs ──
FRONTEND_URL=https://chatpilot.trygetchurnshield.com
PUBLIC_BASE_URL=https://api.trygetchurnshield.com
UPLOADS_DIR=/app/uploads
# Extra browser origins allowed to call this API (comma separated)
EXTRA_CORS_ORIGINS=

# ── WhatsApp gateway (only when the WB service is deployed) ──
WB_BASE_URL=http://whatsapp-bot:3001

# ── Locale ──
DEFAULT_TIMEZONE=Africa/Lagos
DEFAULT_LOCALE=en

# ── AI behaviour ──
AI_MAX_IMAGE_PARTS=4
AI_MAX_HISTORY_MESSAGES=12
# Customer-safe fallbacks are generated from saved conversation state in code.

# Media intelligence: index only a small number of new assets per company/day,
# and avoid reusing a picture while a fresher matching one is available.
MEDIA_INDEX_DAILY_ASSET_BUDGET=5
MEDIA_MIN_REUSE_DAYS=14
FOLLOW_UP_STAGE_HOURS=24,72

# Keep background automation from consuming capacity reserved for live clients.
AI_CLOUDFLARE_DAILY_NEURON_BUDGET=9900
AI_CLOUDFLARE_BACKGROUND_NEURON_BUDGET=8000
AI_GROQ_DAILY_TOKEN_BUDGET=195000
AI_GROQ_BACKGROUND_TOKEN_BUDGET=120000
AI_GEMINI_DAILY_REQUEST_BUDGET=20
AI_GEMINI_BACKGROUND_REQUEST_BUDGET=14

# ── Outbound scraping: keep off. Turning it on costs money and risks bans. ──
SCRAPING_ENABLED=false

# ── Buyer Finder ──
# The core flag permits reads from each company's connected Meta accounts.
# Paid/public Apify fallback additionally requires SCRAPING_ENABLED=true and APIFY_TOKEN.
# Start with company settings in shadow mode so candidates cannot be contacted.
BUYER_FINDER_ENABLED=false
APIFY_TOKEN=
APIFY_FB_COMMENTS_ACTOR=apify/facebook-comments-scraper
BUYER_FINDER_MAX_ACCOUNTS_PER_STATE=15
BUYER_FINDER_MAX_POSTS_PER_ACCOUNT=10
BUYER_FINDER_MAX_COMMENTS_PER_POST=50

# ── Meta (Facebook + Instagram) ──
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
META_OAUTH_REDIRECT_URI=https://api.trygetchurnshield.com/api/v1/social/oauth/facebook/callback
META_LOGIN_CONFIG_ID=
META_REPLY_ENABLED=true
META_PRIVATE_REPLY_ENABLED=false
META_MAX_REPLIES_PER_HOUR=15
META_INTENT_MODEL=automatic
META_INTENT_THRESHOLD=0.6
META_DEDUPE_WINDOW_MIN=60
SOCIAL_WA_PREFILL_TEMPLATE=Hi {company}, I saw your property post on {platform} and I'm interested. [{ref}]

# ── Content engine ──
CONTENT_MODEL=automatic
CONTENT_PUBLISH_ENABLED=true

# ── AI learning loop ──
LEARNING_MODEL=automatic
LEARNING_CRON=0 3 * * *
LEARNING_MIN_SAMPLE=6
LEARNING_LOOKBACK_DAYS=30
