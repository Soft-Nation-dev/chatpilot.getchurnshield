# ── Core (required — the app will not boot without these) ──
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://[USER]:[PASSWORD]@postgres:5432/[DATABASE]
REDIS_URL=redis://redis:6379
GEMINI_API_KEY=
chatPilot_API_KEY=

# ── Postgres container ──
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── Auth & encryption ──
# JWT_SECRET also encrypts stored messages. Changing it makes existing
# message history permanently unreadable. Back it up.
JWT_SECRET=
JWT_REFRESH_SECRET=
INVITE_TOKEN_TTL_HOURS=72

# ── Admin surfaces ──
ADMIN_SECRET=
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=

# ── URLs ──
FRONTEND_URL=https://chatpilot.trygetchurnshield.com
PUBLIC_BASE_URL=https://api.trygetchurnshield.com
UPLOADS_DIR=/app/uploads
# Extra browser origins allowed to call this API (comma separated)
EXTRA_CORS_ORIGINS=

# ── WhatsApp gateway (only when the WB service is deployed) ──
WB_BASE_URL=http://whatsapp-bot:3001

# ── Locale ──
DEFAULT_TIMEZONE=Africa/Lagos
DEFAULT_LOCALE=en

# ── AI behaviour ──
AI_MAX_IMAGE_PARTS=4
FOLLOW_UP_STAGE_HOURS=24,72

# ── Outbound scraping: keep off. Turning it on costs money and risks bans. ──
SCRAPING_ENABLED=false

# ── Meta (Facebook + Instagram) ──
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
META_OAUTH_REDIRECT_URI=https://api.trygetchurnshield.com/api/v1/social/oauth/facebook/callback
META_LOGIN_CONFIG_ID=
META_REPLY_ENABLED=true
META_PRIVATE_REPLY_ENABLED=false
META_MAX_REPLIES_PER_HOUR=15
META_INTENT_MODEL=gemini-2.5-flash
META_INTENT_THRESHOLD=0.6
META_DEDUPE_WINDOW_MIN=60
SOCIAL_WA_PREFILL_TEMPLATE=Hi {company}, I saw your property post on {platform} and I'm interested. [{ref}]

# ── Content engine ──
CONTENT_MODEL=gemini-2.5-flash
CONTENT_PUBLISH_ENABLED=true

# ── AI learning loop ──
LEARNING_MODEL=gemini-2.5-flash
LEARNING_CRON=0 3 * * *
LEARNING_MIN_SAMPLE=6
LEARNING_LOOKBACK_DAYS=30
