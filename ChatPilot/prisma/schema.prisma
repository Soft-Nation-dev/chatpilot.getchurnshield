generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model companies {
  id                          Int                          @id(map: "poc_clinics_companies_pkey") @default(autoincrement())
  created_at                  DateTime                     @default(now()) @db.Timestamptz(6)
  name                        String                       @db.VarChar
  cal_event_type_id           BigInt?                      @default(0)
  cal_event_slug              String?                      @db.VarChar
  cal_api_key                 String?                      @db.VarChar
  cal_booking_length          BigInt?
  phone                       BigInt                       @unique(map: "unique phone")
  updated_at                  DateTime?                    @db.Timestamptz(6)
  is_bot_activated            Boolean?                     @default(true)
  session_id                  String?                      @unique(map: "poc_clinics_companies_wapi_id_key")
  whatsapp_connection_status  Boolean?
  assistant_id                Int?
  business_details            Json?
  email                       String?                      @db.VarChar
  monthly_lead_quota          Int?                         @default(300)
  daily_lead_limit            Int?                         @default(50)
  pool_cursor                 Int                          @default(-1)
  wa_inbound_phone            BigInt?
  social_reply_enabled        Boolean?                     @default(true)
  social_reply_template       String?
  vertical                    String?                      @db.VarChar(30)
  timezone                    String?                      @db.VarChar(60)
  locale                      String?                      @db.VarChar(10)
  account_status              String                       @default("active") @db.VarChar(20)
  subscription_plan           String                       @default("trial") @db.VarChar(30)
  subscription_status         String                       @default("pending") @db.VarChar(20)
  subscription_started_at     DateTime?                    @db.Timestamptz(6)
  subscription_expires_at     DateTime?                    @db.Timestamptz(6)
  suspended_at                DateTime?                    @db.Timestamptz(6)
  suspension_reason           String?
  assistant_instructions      assistant_instructions?      @relation(fields: [assistant_id], references: [id])
  contacts                    contacts[]
  users                       users[]
  company_assets              company_assets[]
  leads                       leads[]
  lead_requests               lead_requests[]
  social_accounts             social_accounts[]
  properties                  properties[]
  content_posts               content_posts[]
  content_automation_settings content_automation_settings?
  notifications               notifications[]
  automation_events           automation_events[]
  chat_state_transitions      chat_state_transitions[]

  @@index([account_status])
  @@index([subscription_status, subscription_expires_at])
}

model notifications {
  id         Int       @id @default(autoincrement())
  company_id Int
  type       String    @db.VarChar(40)
  severity   String    @default("info") @db.VarChar(20)
  title      String    @db.VarChar(160)
  message    String
  entity     String?   @db.VarChar(40)
  entity_id  String?   @db.VarChar(80)
  dedupe_key String?   @db.VarChar(160)
  read_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  company    companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, dedupe_key])
  @@index([company_id, read_at, created_at])
}

model users {
  id                     Int       @id @default(autoincrement())
  phone                  String    @unique @db.VarChar
  password               String
  company_id             Int
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime? @updatedAt @db.Timestamptz(6)
  company_name           String?   @db.VarChar
  otp_code               String?   @db.VarChar(6)
  otp_expires_at         DateTime? @db.Timestamptz(6)
  role                   String    @default("owner") @db.VarChar(20)
  status                 String    @default("active") @db.VarChar(20)
  revoked_at             DateTime? @db.Timestamptz(6)
  token_version          Int       @default(0)
  invited_by             Int?
  invite_token           String?   @db.VarChar(128)
  invite_expires_at      DateTime? @db.Timestamptz(6)
  last_login_at          DateTime? @db.Timestamptz(6)
  can_view_contact_phone Boolean   @default(false)
  full_name              String?   @db.VarChar
  company                companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id, status])
  @@index([invite_token])
}

model contacts {
  id                        Int                      @id(map: "poc_clinics_contacts_pkey") @default(autoincrement())
  created_at                DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                @default(now()) @db.Timestamptz(6)
  name                      String?                  @db.VarChar
  phone                     BigInt?
  schedule_event            Json?                    @db.Json
  conversation_state        Json?                    @db.Json
  last_message_received     DateTime                 @default(now()) @db.Timestamptz(6)
  total_messages            Int                      @default(0)
  needs_review              Boolean                  @default(false)
  company_id                Int?                     @default(1)
  photo_url                 String?                  @db.VarChar
  is_bot_activated          Boolean?                 @default(true)
  crm_appointment_at        DateTime?                @db.Timestamptz(6)
  crm_appointment_id        String?                  @db.VarChar
  whatsapp_profile_name     String?
  contact_stop_date         DateTime?                @db.Timestamptz(6)
  is_replies_activated      Boolean?                 @default(true)
  is_follow_up_sent         Boolean                  @default(false)
  lid                       BigInt?
  budget_min                BigInt?
  budget_max                BigInt?
  budget_currency           String?                  @default("NGN") @db.VarChar(8)
  budget_raw                String?
  property_type             String?                  @db.VarChar(50)
  preferred_location        String?                  @db.VarChar(120)
  bedrooms                  Int?
  title_preference          String?                  @db.VarChar(60)
  purchase_timeline         String?                  @db.VarChar(30)
  payment_plan              String?                  @db.VarChar(30)
  qualification_notes       String?
  qual_stage                String                   @default("new") @db.VarChar(20)
  lead_score                Int                      @default(0)
  source                    String?                  @db.VarChar(30)
  source_ref                String?                  @db.VarChar(40)
  social_event_id           Int?
  assigned_user_id          Int?
  follow_up_stage           Int                      @default(0)
  last_follow_up_at         DateTime?                @db.Timestamptz(6)
  chat_state                String                   @default("NEW") @db.VarChar(32)
  chat_state_version        Int                      @default(0)
  state_changed_at          DateTime                 @default(now()) @db.Timestamptz(6)
  state_change_reason       String?                  @db.VarChar(240)
  follow_up_count           Int                      @default(0)
  follow_up_due_at          DateTime?                @db.Timestamptz(6)
  last_customer_message_at  DateTime?                @db.Timestamptz(6)
  last_automated_message_at DateTime?                @db.Timestamptz(6)
  companies                 companies?               @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "poc_clinics_contacts_company_id_fk")
  messages                  messages[]
  automation_events         automation_events[]
  chat_state_transitions    chat_state_transitions[]

  @@unique([company_id, phone], map: "poc_clinics_contacts_company_phone_key")
  @@index([company_id, qual_stage])
  @@index([company_id, source])
  @@index([source_ref])
  @@index([company_id, follow_up_stage, last_message_received])
  @@index([company_id, chat_state, last_message_received])
  @@index([chat_state, follow_up_due_at])
}

model chat_state_transitions {
  id         Int       @id @default(autoincrement())
  company_id Int
  contact_id Int
  from_state String    @db.VarChar(32)
  to_state   String    @db.VarChar(32)
  reason     String?   @db.VarChar(240)
  actor      String    @default("system") @db.VarChar(32)
  job_id     String?   @db.VarChar(120)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  company    companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  contact    contacts  @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@index([contact_id, created_at])
  @@index([company_id, created_at])
}

model automation_events {
  id            Int       @id @default(autoincrement())
  company_id    Int
  contact_id    Int?
  job_type      String    @db.VarChar(40)
  status        String    @db.VarChar(20)
  attempt       Int       @default(1)
  max_attempts  Int       @default(1)
  job_id        String?   @db.VarChar(120)
  provider      String?   @db.VarChar(40)
  latency_ms    Int?
  error_code    String?   @db.VarChar(80)
  error_message String?
  details       Json?
  started_at    DateTime  @default(now()) @db.Timestamptz(6)
  completed_at  DateTime? @db.Timestamptz(6)
  company       companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  contact       contacts? @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@index([company_id, started_at])
  @@index([contact_id, started_at])
  @@index([status, started_at])
  @@index([job_id])
}

model messages {
  id                    Int       @id @default(autoincrement())
  contact_id            Int
  sender_phone          BigInt?
  message               String
  image_url             String?
  sent_at               DateTime? @default(now()) @db.Timestamp(6)
  is_read               Boolean?  @default(false)
  message_type          String?   @default("text") @db.VarChar(50)
  author_type           String    @default("bot") @db.VarChar(50)
  processed             Boolean   @default(false)
  original_message_type String?   @default("text") @db.VarChar(50)
  wb_id                 String?   @db.VarChar
  exclude_from_ai       Boolean   @default(false)
  contacts              contacts  @relation(fields: [contact_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([contact_id, wb_id])
}

model ai_usage_events {
  id              Int      @id @default(autoincrement())
  company_id      Int?
  contact_id      Int?
  workload        String   @db.VarChar(40)
  provider        String   @db.VarChar(30)
  model           String   @db.VarChar(120)
  status          String   @db.VarChar(20)
  input_tokens    Int      @default(0)
  output_tokens   Int      @default(0)
  total_tokens    Int      @default(0)
  estimated_units Float    @default(0)
  latency_ms      Int      @default(0)
  fallback_index  Int      @default(0)
  error_code      String?  @db.VarChar(40)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([provider, created_at])
  @@index([company_id, created_at])
  @@index([workload, created_at])
}

model assistant_instructions {
  id            Int         @id(map: "poc_assistant_instructions_pkey") @default(autoincrement())
  model         String?     @default("gemini-3.6-flash")
  temperature   Float?      @default(0.1)
  system_prompt String?
  companies     companies[]
}

model company_assets {
  id                       Int       @id @default(autoincrement())
  company_id               Int
  file_url                 String
  file_type                String    @db.VarChar(20)
  file_name                String    @db.VarChar(255)
  description              String?
  mime_type                String?   @db.VarChar(120)
  source                   String    @default("company-upload") @db.VarChar(30)
  source_ref               String?   @db.VarChar(120)
  content_hash             String?   @db.VarChar(64)
  ai_summary               String?
  ai_tags                  String?
  indexed_at               DateTime? @db.Timestamptz(6)
  property_extracted_at    DateTime? @db.Timestamptz(6)
  extracted_property_count Int       @default(0)
  last_used_at             DateTime? @db.Timestamptz(6)
  use_count                Int       @default(0)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  company                  companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, file_url])
  @@index([company_id])
  @@index([company_id, file_type, indexed_at])
  @@index([company_id, last_used_at])
}

model leads {
  id               Int       @id @default(autoincrement())
  company_id       Int
  name             String?   @db.VarChar
  phone            BigInt?
  email            String?   @db.VarChar
  website          String?   @db.VarChar
  address          String?   @db.VarChar
  source           String?   @db.VarChar
  source_id        String?   @db.VarChar
  raw_text         String?
  location_state   String?   @db.VarChar
  status           String    @default("new") @db.VarChar
  qual_score       Float     @default(0)
  notes            String?
  is_bot_activated Boolean   @default(true)
  contact_id       Int?
  last_contact_at  DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @updatedAt @db.Timestamptz(6)
  company          companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, phone])
  @@index([company_id, status])
}

model lead_requests {
  id         Int       @id @default(autoincrement())
  company_id Int
  target     Int       @default(0)
  found      Int       @default(0)
  status     String    @default("pending") @db.VarChar
  sources    String?   @db.VarChar
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)
  company    companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
}

model pool {
  id             Int      @id @default(autoincrement())
  name           String?  @db.VarChar
  phone          BigInt   @unique
  email          String?  @db.VarChar
  website        String?  @db.VarChar
  address        String?  @db.VarChar
  source         String?  @db.VarChar
  source_id      String?  @db.VarChar
  raw_text       String?
  location_state String?  @db.VarChar
  qual_score     Float    @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
}

model properties {
  id                 Int             @id @default(autoincrement())
  company_id         Int
  title              String          @db.VarChar(200)
  description        String?
  property_type      String?         @db.VarChar(50)
  location           String?         @db.VarChar(120)
  state              String?         @db.VarChar(60)
  price              BigInt?
  price_max          BigInt?
  currency           String?         @default("NGN") @db.VarChar(8)
  size_sqm           Int?
  bedrooms           Int?
  bathrooms          Int?
  title_document     String?         @db.VarChar(60)
  payment_plan       String?
  features           String?
  image_urls         String?
  video_url          String?
  status             String          @default("available") @db.VarChar(20)
  source_asset_id    Int?
  source_fingerprint String?         @db.VarChar(64)
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?       @updatedAt @db.Timestamptz(6)
  company            companies       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  content_posts      content_posts[]

  @@unique([company_id, source_asset_id, source_fingerprint])
  @@index([company_id, status])
  @@index([company_id, source_asset_id])
}

model content_posts {
  id                   Int         @id @default(autoincrement())
  company_id           Int
  property_id          Int?
  kind                 String      @db.VarChar(30)
  topic                String?     @db.VarChar(200)
  caption              String
  hashtags             String?
  image_urls           String?
  platforms            String?     @default("facebook,instagram") @db.VarChar(60)
  status               String      @default("draft") @db.VarChar(20)
  scheduled_at         DateTime?   @db.Timestamptz(6)
  published_at         DateTime?   @db.Timestamptz(6)
  fb_post_id           String?     @db.VarChar
  ig_post_id           String?     @db.VarChar
  error                String?
  comments_count       Int         @default(0)
  wa_clicks            Int         @default(0)
  automation_generated Boolean     @default(false)
  created_at           DateTime    @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?   @updatedAt @db.Timestamptz(6)
  company              companies   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  property             properties? @relation(fields: [property_id], references: [id], onDelete: SetNull)

  @@index([company_id, status])
  @@index([company_id, scheduled_at])
  @@index([company_id, automation_generated, status, scheduled_at])
  @@index([fb_post_id])
  @@index([ig_post_id])
}

model learned_guidelines {
  id          Int       @id @default(autoincrement())
  company_id  Int
  scope       String    @db.VarChar(30)
  guidelines  String
  sample_size Int       @default(0)
  won_count   Int       @default(0)
  lost_count  Int       @default(0)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)

  @@index([company_id, scope, is_active])
}

model audit_logs {
  id         Int      @id @default(autoincrement())
  company_id Int
  user_id    Int?
  action     String   @db.VarChar(60)
  entity     String?  @db.VarChar(40)
  entity_id  String?  @db.VarChar(40)
  meta       Json?
  ip         String?  @db.VarChar(45)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([company_id, created_at])
  @@index([company_id, action])
}

model social_accounts {
  id               Int       @id @default(autoincrement())
  company_id       Int
  platform         String    @db.VarChar(20)
  external_id      String    @db.VarChar
  page_id          String?   @db.VarChar
  ig_user_id       String?   @db.VarChar
  name             String?   @db.VarChar
  username         String?   @db.VarChar
  access_token     String
  token_expires_at DateTime? @db.Timestamptz(6)
  scopes           String?
  is_active        Boolean   @default(true)
  subscribed_at    DateTime? @db.Timestamptz(6)
  last_error       String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @updatedAt @db.Timestamptz(6)
  company          companies @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([platform, external_id])
  @@index([company_id])
  @@index([company_id, is_active])
}

model social_events {
  id                 Int       @id @default(autoincrement())
  company_id         Int?
  social_account_id  Int?
  platform           String    @db.VarChar(20)
  event_type         String    @db.VarChar(20)
  external_id        String    @db.VarChar
  external_user_id   String?   @db.VarChar
  external_user_name String?   @db.VarChar
  post_id            String?   @db.VarChar
  parent_id          String?   @db.VarChar
  text               String?
  intent             String?   @db.VarChar(20)
  intent_score       Float?
  classifier         String?   @db.VarChar(20)
  action             String    @default("received") @db.VarChar(30)
  reply_text         String?
  wa_link            String?
  ref_code           String?   @unique @db.VarChar(16)
  content_post_id    Int?
  error              String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @updatedAt @db.Timestamptz(6)

  @@unique([platform, external_id])
  @@index([company_id, created_at])
  @@index([social_account_id, action, created_at])
}

model whats_app_session {
  id        Int      @id @default(autoincrement())
  sessionId String   @unique
  creds     Json?
  keys      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId], map: "idx_whats_app_session_sessionId")
}

model content_automation_settings {
  id                Int       @id @default(autoincrement())
  company_id        Int       @unique
  enabled           Boolean   @default(false)
  posts_per_day     Int       @default(2)
  posting_times     Json?
  posting_days      Json?
  platforms         String    @default("facebook,instagram") @db.VarChar(60)
  approval_required Boolean   @default(true)
  property_ratio    Int       @default(100)
  min_reuse_days    Int       @default(14)
  timezone          String    @default("Africa/Lagos") @db.VarChar(60)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @updatedAt @db.Timestamptz(6)
  company           companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
}

model wb_messages_cache {
  id        Int      @id @default(autoincrement())
  sessionId String
  messageId String
  message   Json
  createdAt DateTime @default(now())

  @@unique([sessionId, messageId], map: "uniq_wb_msg_cache_session_message")
  @@index([sessionId], map: "idx_wb_msg_cache_sessionId")
  @@index([createdAt], map: "idx_wb_msg_cache_createdAt")
}
