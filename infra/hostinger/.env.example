# PostgreSQL (use strong production values)
POSTGRES_USER=chatpilot
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=chatpilot
DATABASE_URL=postgresql://chatpilot:replace-me@postgres:5432/chatpilot

# Public application URLs
FRONTEND_URL=https://chatpilot.trygetchurnshield.com
PUBLIC_BASE_URL=https://api.trygetchurnshield.com
WB_BASE_URL=http://whatsapp-bot:3001

# Application secrets and provider credentials
JWT_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
ADMIN_SECRET=replace-me
GEMINI_API_KEY=replace-me
GROQ_API_KEY=replace-me
CLOUDFLARE_ACCOUNT_ID=replace-me
CLOUDFLARE_API_TOKEN=replace-me
CLOUDFLARE_AI_GATEWAY_ID=default
AI_MAX_HISTORY_MESSAGES=12
AI_UNAVAILABLE_REPLY=Thanks for your message. Our assistant is temporarily unavailable, so I have flagged this conversation for a team member to follow up.
AI_CLOUDFLARE_DAILY_NEURON_BUDGET=9900
AI_CLOUDFLARE_BACKGROUND_NEURON_BUDGET=8000
AI_GROQ_DAILY_TOKEN_BUDGET=195000
AI_GROQ_BACKGROUND_TOKEN_BUDGET=120000
AI_GEMINI_DAILY_REQUEST_BUDGET=20
AI_GEMINI_BACKGROUND_REQUEST_BUDGET=14

# Meta/Facebook/Instagram
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
META_OAUTH_REDIRECT_URI=https://api.trygetchurnshield.com/api/v1/social/oauth/facebook/callback
